{
  "name": "nig-drives",
  "private": true,
  "version": "1.3.3",
  "description": "Nig Drives — OSM 3D driving game (Vite + Three.js + Electron)",
  "author": "Nigel McCoy",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "ELECTRON_DEV=1 electron .",
    "electron:build": "npm run build && electron-builder --win portable",
    "dist:win": "npm run electron:build"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "build": {
    "appId": "com.nigelrmccoy.nig-drives",
    "productName": "Nig Drives",
    "copyright": "Copyright © Nigel McCoy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "NigDrives-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "NigDrives-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "NigDrives-${version}-setup.${ext}"
    }
  }
}
